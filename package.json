{
  "name": "lantai",
  "version": "0.8.0",
  "description": "兰台（Lantai）办公工具箱：PDF / 图片 / Excel / 表格匹配比对 / Office转PDF / 批量替换 / 模板填充 / 文件管理 / 小工具",
  "main": "./out/main/index.js",
  "author": "ruai1024",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/check-renderer.mjs && electron-vite build",
    "check:renderer": "node scripts/check-renderer.mjs",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:ui": "node scripts/ui-smoke.mjs",
    "dist": "electron-vite build && electron-builder",
    "release": "node scripts/release.mjs",
    "gen:icon": "node scripts/make-icon.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "build": {
    "appId": "com.ruai1024.lantai",
    "productName": "兰台",
    "copyright": "Copyright © 2026 ruai1024",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "!**/node_modules/**/*.{md,map,d.ts,ts}"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/ruai0/Lantai/releases/latest/download"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "executableName": "Lantai"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "兰台",
      "uninstallDisplayName": "兰台 办公工具箱",
      "installerLanguages": [
        "zh_CN"
      ],
      "artifactName": "lantai-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "lantai-portable-${version}.${ext}"
    },
    "linux": {
      "executableName": "lantai",
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "ruai1024 <1393930984@qq.com>",
      "vendor": "ruai1024",
      "synopsis": "离线办公文书工具箱",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "lantai-${version}-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docxtemplater": "^3.69.3",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.14.5",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.3.289",
    "pinyin-pro": "^3.29.4",
    "qrcode": "^1.5.4",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  }
}
